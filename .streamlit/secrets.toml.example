# คัดลอกไฟล์นี้เป็น .streamlit/secrets.toml แล้วใส่ key จริง (ไฟล์ secrets.toml ถูก .gitignore ไว้แล้ว)
# บน Streamlit Community Cloud ให้ไปที่ App settings > Secrets แล้ววางบรรทัดด้านล่าง
# ใส่อย่างน้อย 1 ตัว ถ้าใส่ทั้งสองตัว ระบบจะสลับไปอีกตัวอัตโนมัติเมื่อตัวที่เลือกใช้งานไม่ได้ (403/429/5xx)
GROQ_API_KEY = "gsk_your_key_here"        # https://console.groq.com/keys
GEMINI_API_KEY = "your_gemini_key_here"   # https://aistudio.google.com/apikey
